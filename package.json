{
	"name": "blogging-website",
	"version": "1.0.0",
	"description": "A simple blogging website with three pages",
	"scripts": {
		"lint:html": "htmlhint 'src/**/*.html'",
		"lint:css": "stylelint 'styles/**/*.css'",
		"lint": "npm run lint:html && npm run lint:css",
		"lint:fix": "stylelint 'styles/**/*.css' --fix",
		"start": "parcel src/index.html",
		"build": "parcel build src/index.html --dist-dir dist --public-url ./"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/allee-dev/Blogging-Website.git"
	},
	"keywords": [
		"blog",
		"website",
		"html",
		"css"
	],
	"author": "Ali Usman",
	"license": "MIT",
	"devDependencies": {
		"htmlhint": "^1.1.4",
		"stylelint": "^16.0.0",
		"stylelint-config-standard": "^34.0.0"
	}
}
